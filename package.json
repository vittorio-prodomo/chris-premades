{
  "name": "chris-premades",
  "version": "0.0.1",
  "description": "Chris's premade items for high-automation midi-qol games.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "build": "node dev-manifest.mjs && webpack",
    "devManifest": "node dev-manifest.mjs",
    "buildCompendiums": "node packData/packData.mjs",
    "buildCompendiums:backfillDescriptions": "node packData/t43-backfillDescriptions.mjs",
    "extractCompendiums": "node packData/unpackData.mjs",
    "verifyPacks": "node packData/verify-packs.mjs",
    "buildCompendiums:guarded": "sh -c 'node packData/verify-packs.mjs \"$@\" && node packData/packData.mjs \"$@\" && node packData/verify-packs.mjs \"$@\"' --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisk123999/chris-premades.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/chrisk123999/chris-premades/issues"
  },
  "homepage": "https://github.com/chrisk123999/chris-premades#readme",
  "dependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.2",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  }
}
