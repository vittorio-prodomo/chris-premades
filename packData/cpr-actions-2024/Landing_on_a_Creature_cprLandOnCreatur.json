{
  "name": "Landing on a Creature",
  "type": "feat",
  "img": "icons/skills/movement/figure-running-gray.webp",
  "system": {
    "description": {
      "value": "<p><em>Homebrew table rule.</em> Drop from a height onto a creature, then act normally.</p><ul><li><strong>Height DC:</strong> 10 for 20 ft or less · 13 at 21–30 ft · 15 at 31–40 ft · +2 per further 10 ft.</li><li><strong>Aim:</strong> Dexterity (Acrobatics) against the height DC; Advantage if the target is at least one size larger, Disadvantage if at least one size smaller.</li><li><strong>Dodge:</strong> a target that sees you coming may use its reaction for a Dexterity save against your Acrobatics total. If you are Invisible or Hiding, it cannot.</li><li><strong>Hit:</strong> the target is Prone (unless two or more sizes larger). Above 10 ft, the fall damage is split: 2/3 to the target, 1/3 to you. You land standing next to it.</li><li><strong>Miss or dodge:</strong> you land Prone next to the target and, above 10 ft, take the full fall damage.</li></ul>",
      "chat": ""
    },
