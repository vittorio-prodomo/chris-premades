{
  "name": "Plunging Attack",
  "type": "feat",
  "img": "icons/skills/melee/strike-sword-stabbed-brown.webp",
  "system": {
    "description": {
      "value": "<p><em>Homebrew table rule.</em> Drop onto a creature with your weapon pointed down — the impact is the attack. Needs a drop of more than 10 ft and a melee weapon; it is one attack of your Attack action.</p><ul><li><strong>Roll:</strong> an ordinary attack roll against AC.</li><li><strong>Fall dice:</strong> 1d6 per full 10 ft, rolled once.</li><li><strong>Hit:</strong> up to 20 ft the target takes all the fall dice on top of the weapon damage and you take none; above 20 ft it takes 2/3 and you take 1/3. They are the weapon's damage type and are not doubled on a critical hit. You land standing next to the target, which is not knocked Prone.</li><li><strong>Miss:</strong> you take the full fall damage and land Prone next to the target.</li></ul>",
      "chat": ""
    },
